{
  "name": "ascendant-agents",
  "version": "2.1.2",
  "private": true,
  "homepage": "https://astro-ascendant.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/astro-ascendant/skills.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "ascendant": "bun skills/ascendant/tools/ascendant.ts",
    "add-person": "bun skills/ascendant/tools/ascendant.ts add-person",
    "check-transit": "bun skills/ascendant/tools/ascendant.ts transit",
    "test": "bun test",
    "build:skill": "bun scripts/build-skill.mjs",
    "check:plugin": "bun scripts/check-plugin-externals.mjs",
    "sync-versions": "bun scripts/sync-versions.mjs",
    "changeset": "changeset",
    "version": "bun scripts/sync-versions.mjs",
    "typecheck": "tsc --project skills/ascendant/tsconfig.json --noEmit && tsc --project .opencode/tsconfig.json --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt skills/ascendant/tools tests scripts .opencode/plugins packages/ascendant-skills/bin packages/ascendant-skills/lib *.json .oxlintrc.json .oxfmtrc.json skills/ascendant/tsconfig.json .opencode/tsconfig.json",
    "format:check": "bun run format -- --check"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.0.5",
    "@toon-format/toon": "4.4.0",
    "astro-ascendant": "5.1.1",
    "effect": "^4.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "bun-types": "1.4.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@toon-format/toon": "4.4.0"
  },
  "trustedDependencies": [
    "@swisseph/node",
    "msgpackr-extract"
  ]
}
